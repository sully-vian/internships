digraph Architecture {
    // Default styles
    rankdir=LR
    node [shape=box, style=filled, fillcolor=aliceblue];
    edge [color=slategray, arrowsize=0.8];

    // Invisible start node to create the initial incoming arrow
    start [shape=none, label="", width=0, height=0];

    // Define nodes with appropriate styles (rounded vs solid)
    SERV;
    TMP [shape=cylinder, fillcolor=honeydew];
    MERE [shape=cylinder, fillcolor=honeydew];
    CONFLICTS [shape=cylinder, fillcolor=honeydew];
    HIST [shape=cylinder, fillcolor=honeydew];

    // Ensure MERE and CONFLICTS align horizontally
    { rank=same; MERE; CONFLICTS; }

    split [shape=point, width=0, height=0];

    start -> SERV [label="1."];
    SERV -> TMP [label="2."];
    
    TMP -> split [label="3.", arrowhead=none];
    split -> MERE;
    split -> CONFLICTS;

    CONFLICTS -> MERE [label="4.1\n4.2"];
    MERE -> HIST [label="4.2"];
    CONFLICTS -> HIST [label="4.3"];
}
