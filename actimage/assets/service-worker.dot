digraph G {
    // Graph layout and spacing
    rankdir=LR;
    nodesep=0.8;
    ranksep=1.2;
    bgcolor="transparent";

    // Global node settings
    node [
        shape=box,
        style="filled, rounded",
        fontsize=14,
        margin="0.3,0.15",
        penwidth=1.5
    ];

    // Global edge settings
    edge [fontsize=11, penwidth=1.5, arrowsize=0.8];

    // Define nodes with specific thematic colors
    WebApp [label="Application\nONaCVG", fillcolor="#f8f9fa", color="#ced4da"];
    
    SW [label="Service Worker", fillcolor="#e7f5ff", color="#339af0"];
    
    Cache [
        shape=cylinder, // Overrides rounded for cylinder
        style="filled",
        label="Cache\nnavigateur",
        fillcolor="#fff0f6",
        color="#f06595"
    ];
    
    Server [label="Serveur Web", fillcolor="#ebfbee", color="#51cf66"];

    {rank=same; Cache; Server;}

    // Standard flows (Neutral grey)
    WebApp -> SW [label=" Requête", color="#495057", fontcolor="#495057"];
    SW -> WebApp [label=" Réponse finale", color="#495057", fontcolor="#495057"];

    // Offline flows (Muted red)
    SW -> Cache [color="#e03131", label=" Hors ligne", fontcolor="#e03131"];
    Cache -> SW [color="#e03131", label=" Réponse en cache", fontcolor="#e03131"];

    // Online flows (Forest green)
    SW -> Server [color="#2b8a3e", label=" En ligne", fontcolor="#2b8a3e"];
    Server -> SW [color="#2b8a3e", label=" Réponse serveur", fontcolor="#2b8a3e"];
    SW -> Cache [color="#2b8a3e", style=dashed, label=" Mise à jour du cache", fontcolor="#2b8a3e"];
}
